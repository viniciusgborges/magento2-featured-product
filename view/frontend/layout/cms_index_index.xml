<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content.top">
            <block class="Vbdev\FeaturedProduct\Block\FeaturedProduct"
                   name="vbdev.featured.product"
                   template="Vbdev_FeaturedProduct::featured-product.phtml"
                   before="-"
                   ifconfig="vbdev_featured_product/general/enabled">
                <arguments>
                    <argument name="view_model" xsi:type="object">
                        Vbdev\FeaturedProduct\ViewModel\FeaturedProduct
                    </argument>
                    <argument name="image_id" xsi:type="string">product_base_image</argument>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="vbdevFeaturedStock" xsi:type="array">
                                <item name="component" xsi:type="string">
                                    Vbdev_FeaturedProduct/js/view/featured-stock
                                </item>
                                <item name="config" xsi:type="array">
                                    <item name="template" xsi:type="string">Vbdev_FeaturedProduct/featured-stock</item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
